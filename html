                state.pendingUnlockChapterId = chapter.id;
                document.getElementById('unlock-chapter-name').textContent = `${story.title} - ${chapter.title}`;
                document.getElementById('modal-coin-balance').textContent = state.userCoins;
                const modal = document.getElementById('unlock-modal');
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                return;
            }

            playChapter(chapterId);
        }

        // ==================== 6. AUDIO PLAYER & WEB SPEECH API (TTS) ====================
        function playChapter(chapterId) {
            const story = STORIES_DATA.find(s => s.id === state.selectedStoryId);
            const chapter = story.chapters.find(c => c.id === chapterId);
            if (!chapter) return;

            // Count banner impression on chapter change
            if (state.adConfig.banner) {
                recordAdImpression('banner', 1);
            }

            state.currentChapterId = chapterId;
            state.elapsedSeconds = 0;
            state.progressPercent = 0;

            // Update Player Bar Info
            document.getElementById('player-cover').src = story.cover;
            document.getElementById('player-title').textContent = story.title;
            document.getElementById('player-chapter').textContent = chapter.title;
            document.getElementById('time-duration').textContent = chapter.duration;
            document.getElementById('time-current').textContent = '00:00';
            document.getElementById('progress-slider').value = 0;

            const vipBadge = document.getElementById('player-vip-badge');
            if (chapter.isLocked) vipBadge.classList.remove('hidden');
            else vipBadge.classList.add('hidden');

            // Update Transcript View
            document.getElementById('transcript-chapter-title').textContent = chapter.title;
            document.getElementById('transcript-text').textContent = chapter.content;
            switchSubTab('transcript');

            renderChapterList(story);
            startAudioPlayback(chapter.content);
        }

        function startAudioPlayback(textToRead) {
            stopAudioPlayback();
            state.isPlaying = true;
            updatePlayButtonUI();

            // Web Speech API (Vietnamese TTS)
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                speechUtterance = new SpeechSynthesisUtterance(textToRead);
                speechUtterance.lang = 'vi-VN';
                speechUtterance.rate = state.playbackRate;
                speechUtterance.volume = state.volume;

                speechUtterance.onend = () => {
                    if (state.isPlaying) {
                        nextChapter();
                    }
                };
                window.speechSynthesis.speak(speechUtterance);
            }

            // Progress & Mid-Roll Ad Timer Loop
            playbackInterval = setInterval(() => {
                if (!state.isPlaying) return;

                state.elapsedSeconds += 1;
                state.listenSecondsSinceLastAd += 1;

                if (state.elapsedSeconds >= state.totalSeconds) {
                    state.elapsedSeconds = 0;
                    nextChapter();
                    return;
                }

                // Update Timeline UI
                const pct = Math.min(100, Math.round((state.elapsedSeconds / state.totalSeconds) * 100));
                document.getElementById('progress-slider').value = pct;
                document.getElementById('time-current').textContent = formatTime(state.elapsedSeconds);

                // Automatic Mid-roll Ad Trigger (every 35 seconds of listening if not VIP)
                if (state.adConfig.midroll && !state.isVip && state.listenSecondsSinceLastAd >= 35) {
                    state.listenSecondsSinceLastAd = 0;
                    triggerMidRollAd(false);
                }
            }, 1000);
        }

        function stopAudioPlayback() {
            state.isPlaying = false;
            updatePlayButtonUI();
            if (playbackInterval) clearInterval(playbackInterval);
            if ('speechSynthesis' in window) {
                window.speechSynthesis.pause();
            }
        }

        function togglePlay() {
            const story = STORIES_DATA.find(s => s.id === state.selectedStoryId);
            const chapter = story.chapters.find(c => c.id === state.currentChapterId);

            if (state.isPlaying) {
                stopAudioPlayback();
            } else {
                if ('speechSynthesis' in window && window.speechSynthesis.paused) {
                    state.isPlaying = true;
                    updatePlayButtonUI();
                    window.speechSynthesis.resume();
                    playbackInterval = setInterval(() => {
                        if (!state.isPlaying) return;
                        state.elapsedSeconds += 1;
                        state.listenSecondsSinceLastAd += 1;
                        const pct = Math.min(100, Math.round((state.elapsedSeconds / state.totalSeconds) * 100));
                        document.getElementById('progress-slider').value = pct;
                        document.getElementById('time-current').textContent = formatTime(state.elapsedSeconds);
                        if (state.adConfig.midroll && !state.isVip && state.listenSecondsSinceLastAd >= 35) {
                            state.listenSecondsSinceLastAd = 0;
                            triggerMidRollAd(false);
                        }
                    }, 1000);
                } else {
                    startAudioPlayback(chapter.content);
                }
            }
        }

        function updatePlayButtonUI() {
            const mainIcon = document.getElementById('main-play-icon');
            const mobileIcon = document.getElementById('mobile-play-icon');
            const wave = document.getElementById('sound-wave');
            const liveDot = document.getElementById('live-dot');

            if (state.isPlaying) {
                mainIcon.setAttribute('data-lucide', 'pause');
                mobileIcon.setAttribute('data-lucide', 'pause');
                wave.classList.remove('opacity-0');
                wave.classList.add('playing');
                liveDot.classList.remove('hidden');
            } else {
                mainIcon.setAttribute('data-lucide', 'play');
                mobileIcon.setAttribute('data-lucide', 'play');
                wave.classList.add('opacity-0');
                wave.classList.remove('playing');
                liveDot.classList.add('hidden');
            }
            lucide.createIcons();
        }

        function seekRelative(delta) {
            state.elapsedSeconds = Math.max(0, Math.min(state.totalSeconds, state.elapsedSeconds + delta));
            const pct = Math.round((state.elapsedSeconds / state.totalSeconds) * 100);
            document.getElementById('progress-slider').value = pct;
            document.getElementById('time-current').textContent = formatTime(state.elapsedSeconds);
        }

        function onSeekSlider(val) {
            state.elapsedSeconds = Math.round((val / 100) * state.totalSeconds);
            document.getElementById('time-current').textContent = formatTime(state.elapsedSeconds);
        }

        function prevChapter() {
            const story = STORIES_DATA.find(s => s.id === state.selectedStoryId);
            const idx = story.chapters.findIndex(c => c.id === state.currentChapterId);
            if (idx > 0) {
                handleChapterClick(story.chapters[idx - 1].id);
            } else {
                showToast('Bạn đang ở chương đầu tiên của truyện.', 'info');
            }
        }

        function nextChapter() {
            const story = STORIES_DATA.find(s => s.id === state.selectedStoryId);
            const idx = story.chapters.findIndex(c => c.id === state.currentChapterId);
            if (idx < story.chapters.length - 1) {
                handleChapterClick(story.chapters[idx + 1].id);
            } else {
                stopAudioPlayback();
                showToast('Đã phát hết các chương hiện có!', 'success');
            }
        }

        function cycleSpeed() {
            const speeds = [0.75, 1.0, 1.25, 1.5, 2.0];
            const nextIdx = (speeds.indexOf(state.playbackRate) + 1) % speeds.length;
            state.playbackRate = speeds[nextIdx];
            document.getElementById('speed-btn').textContent = `${state.playbackRate}x`;
            if (state.isPlaying) {
                const story = STORIES_DATA.find(s => s.id === state.selectedStoryId);
                const chapter = story.chapters.find(c => c.id === state.currentChapterId);
                startAudioPlayback(chapter.content);
            }
        }

        function cycleSleepTimer() {
            const options = [0, 15, 30, 60];
            const nextIdx = (options.indexOf(state.sleepTimerMinutes) + 1) % options.length;
            state.sleepTimerMinutes = options[nextIdx];
            document.getElementById('sleep-label').textContent = state.sleepTimerMinutes === 0 ? 'Tắt' : `${state.sleepTimerMinutes}p`;
            if (state.sleepTimerMinutes > 0) {
                showToast(`Đã hẹn giờ tắt âm thanh sau ${state.sleepTimerMinutes} phút.`, 'info');
            }
        }

        function changeVolume(val) {
            state.volume = parseFloat(val);
            const icon = document.getElementById('volume-icon');
            icon.setAttribute('data-lucide', state.volume === 0 ? 'volume-x' : 'volume-2');
            lucide.createIcons();
        }

        function toggleMute() {
            const slider = document.getElementById('volume-slider');
            if (state.volume > 0) {
                slider.value = 0;
                changeVolume(0);
            } else {
                slider.value = 1;
                changeVolume(1);
            }
        }

        function formatTime(sec) {
            const m = Math.floor(sec / 60).toString().padStart(2, '0');
            const s = (sec % 60).toString().padStart(2, '0');
            return `${m}:${s}`;
        }

        // ==================== 7. AD MONETIZATION ENGINE ====================
        function closeUnlockModal() {
            const modal = document.getElementById('unlock-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function startRewardedUnlock() {
            closeUnlockModal();
            openRewardModal('unlock_chapter');
        }

        function unlockWithCoins() {
            if (state.userCoins < 50) {
                showToast('Bạn không đủ 50 Xu! Hãy xem quảng cáo để nhận thêm Xu miễn phí.', 'error');
                return;
            }
            state.userCoins -= 50;
            updateWalletUI();
            if (state.pendingUnlockChapterId) {
                state.unlockedChapters.add(state.pendingUnlockChapterId);
                closeUnlockModal();
                showToast('Đã mở khóa chương VIP bằng 50 Xu!', 'success');
                playChapter(state.pendingUnlockChapterId);
            }
        }

        // Open Rewarded Video or Mid-roll Ad Modal
        function openRewardModal(mode) {
            if (!state.adConfig.rewarded && mode !== 'midroll') {
                showToast('Quảng cáo có thưởng đang tạm tắt trong cấu hình Admin.', 'info');
                return;
            }

            state.adModalMode = mode;
            const wasPlaying = state.isPlaying;
            if (wasPlaying) stopAudioPlayback();

            // Pick random ad creative
            const creative = AD_CREATIVES[Math.floor(Math.random() * AD_CREATIVES.length)];
            document.getElementById('ad-creative-title').textContent = creative.title;
            document.getElementById('ad-creative-desc').textContent = creative.desc;

            const badge = document.getElementById('ad-modal-badge');
            const rewardInfo = document.getElementById('ad-reward-info');
            const skipBtn = document.getElementById('ad-skip-btn');

            let totalDuration = mode === 'midroll' ? 6 : 8;
            let remaining = totalDuration;

            if (mode === 'midroll') {
                badge.textContent = 'Quảng Cáo Giữa Giờ (Mid-Roll)';
                badge.className = 'px-2 py-0.5 text-[10px] font-extrabold uppercase bg-indigo-500 text-white rounded';
                rewardInfo.innerHTML = `<i data-lucide="info" class="w-4 h-4"></i> Truyện sẽ tự động phát tiếp sau quảng cáo`;
                recordAdImpression('midroll', 1);
            } else {
                badge.textContent = 'Quảng Cáo Có Thưởng (Rewarded)';
                badge.className = 'px-2 py-0.5 text-[10px] font-extrabold uppercase bg-amber-500 text-slate-950 rounded';
                rewardInfo.innerHTML = mode === 'unlock_chapter'
                    ? `<i data-lucide="unlock" class="w-4 h-4"></i> Xem hết để mở khóa Chương VIP miễn phí`
                    : `<i data-lucide="gift" class="w-4 h-4"></i> Xem hết để nhận ngay +50 Xu thưởng`;
                recordAdImpression('rewarded', 1);
            }

            document.getElementById('ad-countdown').textContent = remaining;
            document.getElementById('ad-progress-bar').style.width = '0%';
            skipBtn.disabled = true;
            skipBtn.textContent = `Đợi 5s...`;
            skipBtn.className = 'px-3 py-1 rounded-full text-xs font-bold bg-slate-800 text-slate-500 cursor-not-allowed transition';

            const modal = document.getElementById('ad-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            lucide.createIcons();

            if (state.adTimerInterval) clearInterval(state.adTimerInterval);

            let elapsed = 0;
            state.adTimerInterval = setInterval(() => {
                elapsed += 1;
                remaining = Math.max(0, totalDuration - elapsed);
                document.getElementById('ad-countdown').textContent = remaining;
                document.getElementById('ad-progress-bar').style.width = `${(elapsed / totalDuration) * 100}%`;

                // Allow skip after 5 seconds
                if (elapsed >= 5 && remaining > 0) {
                    skipBtn.disabled = false;
                    skipBtn.textContent = mode === 'midroll' ? 'Bỏ qua QC ✕' : 'Bỏ qua (Không thưởng)';
                    skipBtn.className = 'px-3 py-1 rounded-full text-xs font-bold bg-slate-700 hover:bg-slate-600 text-white cursor-pointer transition';
                }

                if (remaining === 0) {
                    clearInterval(state.adTimerInterval);
                    completeAdReward();
                }
            }, 1000);
        }

        function triggerMidRollAd(isManualTest = false) {
            if (state.isVip && !isManualTest) return;
            openRewardModal('midroll');
        }

        function completeAdReward() {
            const modal = document.getElementById('ad-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');

            if (state.adModalMode === 'earn_coins') {
                state.userCoins += 50;
                updateWalletUI();
                showToast('Chúc mừng! Bạn đã nhận được +50 Xu từ quảng cáo.', 'success');
            } else if (state.adModalMode === 'unlock_chapter' && state.pendingUnlockChapterId) {
                state.unlockedChapters.add(state.pendingUnlockChapterId);
                showToast('Đã mở khóa chương VIP thành công!', 'success');
                playChapter(state.pendingUnlockChapterId);
            } else if (state.adModalMode === 'midroll') {
                showToast('Cảm ơn bạn đã ủng hộ tác giả qua quảng cáo!', 'info');
                const story = STORIES_DATA.find(s => s.id === state.selectedStoryId);
                const chapter = story.chapters.find(c => c.id === state.currentChapterId);
                if (chapter) startAudioPlayback(chapter.content);
            }
        }

        function closeAdModal(skippedByUser = false) {
            if (state.adTimerInterval) clearInterval(state.adTimerInterval);
            const modal = document.getElementById('ad-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');

            if (skippedByUser) {
                if (state.adModalMode === 'midroll') {
                    const story = STORIES_DATA.find(s => s.id === state.selectedStoryId);
                    const chapter = story.chapters.find(c => c.id === state.currentChapterId);
                    if (chapter) startAudioPlayback(chapter.content);
                } else {
                    showToast('Bạn đã bỏ qua quảng cáo nên chưa nhận được phần thưởng.', 'info');
                }
            }
        }

        // ==================== 8. REVENUE TRACKING & PUBLISHER DASHBOARD ====================
        function recordAdImpression(type, count = 1) {
            if (!state.adStats[type]) return;
            state.adStats[type].impressions += count;
            const earnedVnd = (count / 1000) * state.adStats[type].ecpmUsd * USD_TO_VND;
            logAdEvent('IMPRESSION', `Hiển thị [${type.toUpperCase()}] (+${count})`, earnedVnd);
            updateRevenueDashboard();
        }

        function handleAdClick(source) {
            let type = 'banner';
            if (source === 'native_feed') type = 'native';
            if (source === 'video_modal') type = state.adModalMode === 'midroll' ? 'midroll' : 'rewarded';

            state.adStats[type].clicks += 1;
            // Direct click bonus revenue (~1,200 VND CPC)
            const cpcBonusVnd = 1200;
            state.adStats[type].impressions += 1;

            logAdEvent('CLICK_CPC', `Người dùng click quảng cáo tại [${source}]`, cpcBonusVnd);
            updateRevenueDashboard();
            showToast('Đang mở trang ưu đãi của nhà tài trợ... (+Doanh thu CPC cho chủ web)', 'success');
        }

        function updateRevenueDashboard() {
            let totalImp = 0;
            let totalClicks = 0;
            let totalUsd = 0;

            const labels = {
                banner: 'Banner Đầu/Cuối Trang',
                native: 'Native Ad Trong Danh Sách',
                midroll: 'Mid-roll Audio/Video Giữa Giờ',
                rewarded: 'Rewarded Video Mở Khóa VIP'
            };

            let tableHtml = '';

            for (const [key, data] of Object.entries(state.adStats)) {
                // Revenue = (Impressions / 1000 * eCPM) + (Clicks * $0.045 CPC)
                const usd = (data.impressions / 1000) * data.ecpmUsd + (data.clicks * 0.045);
                const vnd = Math.round(usd * USD_TO_VND);

                totalImp += data.impressions;
                totalClicks += data.clicks;
                totalUsd += usd;

                tableHtml += `
                    <tr class="hover:bg-slate-800/40 transition">
                        <td class="py-3 px-3 font-medium text-white">${labels[key]}</td>
                        <td class="py-3 px-3 text-right font-mono text-slate-300">${data.impressions.toLocaleString('vi-VN')}</td>
                        <td class="py-3 px-3 text-right font-mono text-amber-400">${data.clicks.toLocaleString('vi-VN')}</td>
                        <td class="py-3 px-3 text-right font-mono text-purple-400">$${data.ecpmUsd.toFixed(2)}</td>
                        <td class="py-3 px-3 text-right font-mono font-bold text-emerald-400">${vnd.toLocaleString('vi-VN')} ₫</td>
                    </tr>
                `;
            }

            const totalVnd = Math.round(totalUsd * USD_TO_VND);
            const avgCtr = totalImp > 0 ? ((totalClicks / totalImp) * 100).toFixed(2) : '0.00';
            const avgEcpm = totalImp > 0 ? ((totalUsd / totalImp) * 1000).toFixed(2) : '0.00';

            document.getElementById('stat-revenue-vnd').textContent = `${totalVnd.toLocaleString('vi-VN')} ₫`;
            document.getElementById('stat-revenue-usd').textContent = `≈ $${totalUsd.toFixed(2)} USD`;
            document.getElementById('stat-impressions').textContent = totalImp.toLocaleString('vi-VN');
            document.getElementById('stat-rewarded-count').textContent = `${state.adStats.rewarded.impressions} lượt xem hết Video`;
            document.getElementById('stat-clicks').textContent = totalClicks.toLocaleString('vi-VN');
            document.getElementById('stat-ctr').textContent = `(${avgCtr}%)`;
            document.getElementById('stat-ecpm').textContent = `$${avgEcpm}`;
            document.getElementById('nav-revenue-badge').textContent = `${totalVnd.toLocaleString('vi-VN')}₫`;

            document.getElementById('ad-breakdown-table').innerHTML = tableHtml;
        }

        function simulateTrafficBurst() {
            state.adStats.banner.impressions += 650;
            state.adStats.banner.clicks += 14;
            state.adStats.native.impressions += 200;
            state.adStats.native.clicks += 8;
            state.adStats.midroll.impressions += 100;
            state.adStats.midroll.clicks += 6;
            state.adStats.rewarded.impressions += 50;
            state.adStats.rewarded.clicks += 12;

            logAdEvent('TRAFFIC_SPIKE', 'Giả lập 1,000 lượt nghe mới hoàn tất!', 145000);
            updateRevenueDashboard();
            showToast('Đã mô phỏng +1,000 lượt nghe truyện! Doanh thu tăng đáng kể.', 'success');
        }

        function resetAdStats() {
            state.adStats = {
                banner: { impressions: 0, clicks: 0, ecpmUsd: 1.80 },
                native: { impressions: 0, clicks: 0, ecpmUsd: 3.20 },
                midroll: { impressions: 0, clicks: 0, ecpmUsd: 7.50 },
                rewarded: { impressions: 0, clicks: 0, ecpmUsd: 12.50 }
            };
            document.getElementById('ad-event-logs').innerHTML = '';
            logAdEvent('RESET', 'Đã đặt lại toàn bộ dữ liệu thống kê quảng cáo.', 0);
            updateRevenueDashboard();
        }

        function logAdEvent(tag, message, vndAmount) {
            const logBox = document.getElementById('ad-event-logs');
            if (!logBox) return;
            const now = new Date().toLocaleTimeString('vi-VN');
            const badgeColor = tag === 'CLICK_CPC' ? 'text-amber-400' : (tag === 'TRAFFIC_SPIKE' ? 'text-purple-400' : 'text-emerald-400');
            const amountStr = vndAmount > 0 ? `<span class="text-emerald-400 font-bold">+${Math.round(vndAmount).toLocaleString('vi-VN')}₫</span>` : '';

            const entry = document.createElement('div');
            entry.className = 'flex items-center justify-between border-b border-slate-800/50 pb-1.5';
            entry.innerHTML = `
                <div class="truncate pr-2">
                    <span class="text-slate-500">[${now}]</span>
                    <span class="${badgeColor} font-bold">[${tag}]</span>
                    <span class="text-slate-300">${message}</span>
                </div>
                ${amountStr}
            `;
            logBox.prepend(entry);
        }

        function toggleAdConfig(type) {
            const isChecked = document.getElementById(`cfg-${type}`).checked;
            state.adConfig[type] = isChecked;

            if (type === 'banner') {
                document.getElementById('top-ad-banner').style.display = isChecked ? 'block' : 'none';
                document.getElementById('player-ad-strip').style.display = isChecked ? 'flex' : 'none';
            }
            showToast(`Đã ${isChecked ? 'BẬT' : 'TẮT'} quảng cáo ${type.toUpperCase()}.`, 'info');
        }

        function closeTopBanner() {
            document.getElementById('top-ad-banner').style.display = 'none';
        }

        // ==================== 9. WALLET, VIP & TOAST HELPERS ====================
        function updateWalletUI() {
            document.getElementById('user-coins').textContent = state.userCoins;
        }

        function toggleVipModal() {
            const modal = document.getElementById('vip-modal');
            if (modal.classList.contains('hidden')) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            } else {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        function activateVipSimulation() {
            state.isVip = !state.isVip;
            const crown = document.getElementById('vip-crown-icon');
            const label = document.getElementById('vip-label');
            const btn = document.getElementById('btn-activate-vip');

            if (state.isVip) {
                crown.classList.remove('text-slate-400');
                crown.classList.add('text-amber-400');
                label.textContent = 'Hội Viên VIP';
                label.classList.add('text-amber-400');
                btn.textContent = 'Hủy Trạng Thái VIP (Quay lại dùng QC)';
                document.getElementById('top-ad-banner').style.display = 'none';
                document.getElementById('player-ad-strip').style.display = 'none';
                showToast('Đã kích hoạt VIP: Tắt toàn bộ quảng cáo & Mở khóa mọi chương!', 'success');
            } else {
                crown.classList.add('text-slate-400');
                crown.classList.remove('text-amber-400');
                label.textContent = 'Thường';
                label.classList.remove('text-amber-400');
                btn.textContent = 'Bật Trải Nghiệm VIP (Demo)';
                if (state.adConfig.banner) {
                    document.getElementById('top-ad-banner').style.display = 'block';
                    document.getElementById('player-ad-strip').style.display = 'flex';
                }
                showToast('Đã chuyển về tài khoản thường (Có chèn quảng cáo).', 'info');
            }

            toggleVipModal();
            const story = STORIES_DATA.find(s => s.id === state.selectedStoryId);
            if (story) renderChapterList(story);
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            const colors = {
                success: 'bg-emerald-950/95 border-emerald-500/50 text-emerald-200',
                error: 'bg-red-950/95 border-red-500/50 text-red-200',
                info: 'bg-slate-900/95 border-amber-500/50 text-slate-200'
            };

            toast.className = `pointer-events-auto px-4 py-3 rounded-xl border ${colors[type]} shadow-xl backdrop-blur-md text-xs sm:text-sm font-medium flex items-center gap-2.5 transform transition-all duration-300 translate-x-0`;
            toast.innerHTML = `
                <span class="w-2 h-2 rounded-full ${type === 'success' ? 'bg-emerald-400' : (type === 'error' ? 'bg-red-400' : 'bg-amber-400')}"></span>
                <span>${message}</span>
            `;

            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(() => toast.remove(), 300);
            }, 3200);
        }
    </script>
</body>
</html>
